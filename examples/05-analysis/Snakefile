## A data analysis pipeline: raw data in, report out.
##
## The shape is the same as the simulation example -- rules whose inputs and
## outputs are files -- but the chain is mostly linear rather than a fan-out, and
## the first input is a file you did not generate and must not modify.

rule all:
    input:
        "report.html"

rule clean:
    input:
        script = "scripts/clean.R",
        data = "data/trial.csv"
    output:
        "rds/clean.rds"
    log:
        "logs/clean.log"
    shell:
        "Rscript {input.script} --in {input.data} --out {output} > {log} 2>&1"

## Table 1 in the usual sense: who was studied, not what happened to them.  It
## describes the analysis set, so it hangs off the cleaned data and has nothing to
## do with the models.
rule table1:
    input:
        script = "scripts/table1.R",
        setup = "scripts/setup.R",
        rds = "rds/clean.rds"
    output:
        "rds/table1.rds"
    log:
        "logs/table1.log"
    shell:
        "Rscript {input.script} --in {input.rds} --out {output} > {log} 2>&1"

rule analysis:
    input:
        script = "scripts/analysis.R",
        rds = "rds/clean.rds"
    output:
        "rds/analysis.rds"
    log:
        "logs/analysis.log"
    shell:
        "Rscript {input.script} --in {input.rds} --out {output} > {log} 2>&1"

## Table 2: what happened.  Built from the fitted models, so a change to a
## specification reaches it directly and a change to the cleaning reaches it
## through them.
rule table2:
    input:
        script = "scripts/table2.R",
        rds = "rds/analysis.rds"
    output:
        "rds/table2.rds"
    log:
        "logs/table2.log"
    shell:
        "Rscript {input.script} --in {input.rds} --out {output} > {log} 2>&1"

rule figure1:
    input:
        script = "scripts/figure.R",
        setup = "scripts/setup.R",
        rds = "rds/clean.rds"
    output:
        "out/figure1.png"
    log:
        "logs/figure1.log"
    shell:
        "Rscript {input.script} --in {input.rds} --out {output} > {log} 2>&1"

## Listing every object the report reads is what makes the report trustworthy:
## it cannot be rendered against a stale table or a figure from last month.
rule report:
    input:
        qmd = "report.qmd",
        clean = "rds/clean.rds",
        table1 = "rds/table1.rds",
        table2 = "rds/table2.rds",
        figure1 = "out/figure1.png"
    output:
        "report.html"
    log:
        "logs/report.log"
    shell:
        "quarto render {input.qmd} --to html > {log} 2>&1"
