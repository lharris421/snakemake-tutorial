configfile: "config.yaml"

## The iteration count names the directory the results go in, so a 20-iteration
## smoke run and a 1000-iteration final run sit side by side instead of
## overwriting each other.  ITER picks which of them the paper is built from.
ITER = config["iterations"]

wildcard_constraints:
    iterations = r"\d+",
    n = r"\d+",
    rho = r"\d+",
    method = "[a-z]+"

## Everything the manuscript is built from, in one place.  If it is not reachable
## from here, `snakemake` will not make it.
SIMS = expand("rds/{iterations}/sim/n{n}_rho{rho}_{method}.rds",
              iterations=ITER, n=config["n"], rho=config["rho"],
              method=config["methods"])

rule all:
    input:
        "build/paper.pdf",
        "build/submission.pdf"

rule sim:
    input:
        script = "code/sim.R",
        setup = "code/setup.R"
    output:
        "rds/{iterations}/sim/n{n}_rho{rho}_{method}.rds"
    log:
        "logs/{iterations}/sim/n{n}_rho{rho}_{method}.log"
    benchmark:
        "benchmarks/{iterations}/sim/n{n}_rho{rho}_{method}.tsv"
    params:
        seed = config["seed"],
        level = config["level"]
    shell:
        "Rscript {input.script} "
        "--n {wildcards.n} "
        "--rho {wildcards.rho} "
        "--method {wildcards.method} "
        "--iterations {wildcards.iterations} "
        "--seed {params.seed} "
        "--level {params.level} "
        "--out {output} > {log} 2>&1"

rule figure1:
    input:
        script = "code/figure.R",
        setup = "code/setup.R",
        rds = SIMS
    output:
        "out/figure1.pdf"
    log:
        "logs/figure1.log"
    params:
        level = config["level"]
    shell:
        "Rscript {input.script} --out {output} --level {params.level} "
        "{input.rds} > {log} 2>&1"

rule table1:
    input:
        script = "code/table.R",
        setup = "code/setup.R",
        rds = SIMS
    output:
        "out/table1.tex"
    log:
        "logs/table1.log"
    params:
        level = config["level"]
    shell:
        "Rscript {input.script} --out {output} --level {params.level} "
        "{input.rds} > {log} 2>&1"

## The manuscript depends on the figure and the table, which depend on the
## simulations, which depend on the code.  That chain is the whole point: change
## sim.R and `snakemake` rebuilds the PDF, through every step in between.
rule manuscript:
    input:
        tex = "{doc}.tex",
        shared = ["main.tex", "preamble.tex"],
        figure = "out/figure1.pdf",
        table = "out/table1.tex"
    output:
        "build/{doc}.pdf"
    log:
        "logs/{doc}-latexmk.log"
    wildcard_constraints:
        doc = "paper|submission"
    shell:
        "latexmk -pdf -interaction=nonstopmode -outdir=build {input.tex} "
        "> {log} 2>&1"
