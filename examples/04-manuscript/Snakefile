configfile: "config.yaml"

wildcard_constraints:
    n = r"\d+",
    rho = r"\d+",
    method = "[a-z]+"

## Everything the manuscript is built from, in one place.  If it is not reachable
## from here, `snakemake` will not make it.
SIMS = expand("results/sim/n{n}_rho{rho}_{method}.rds",
              n=config["n"], rho=config["rho"], method=config["methods"])

rule all:
    input:
        "build/paper.pdf",
        "build/submission.pdf"

rule sim:
    input:
        script = "code/sim.R",
        setup = "code/setup.R"
    output:
        "results/sim/n{n}_rho{rho}_{method}.rds"
    log:
        "logs/sim/n{n}_rho{rho}_{method}.log"
    benchmark:
        "benchmarks/sim/n{n}_rho{rho}_{method}.tsv"
    params:
        iterations = config["iterations"],
        seed = config["seed"],
        level = config["level"]
    shell:
        "Rscript {input.script} "
        "--n {wildcards.n} "
        "--rho {wildcards.rho} "
        "--method {wildcards.method} "
        "--iterations {params.iterations} "
        "--seed {params.seed} "
        "--level {params.level} "
        "--out {output} > {log} 2>&1"

rule figure1:
    input:
        script = "code/figure.R",
        setup = "code/setup.R",
        rds = SIMS
    output:
        "results/figure1.pdf"
    log:
        "logs/figure1.log"
    params:
        level = config["level"]
    shell:
        "Rscript {input.script} --out {output} --level {params.level} "
        "{input.rds} > {log} 2>&1"

rule table1:
    input:
        script = "code/table.R",
        setup = "code/setup.R",
        rds = SIMS
    output:
        "results/table1.tex"
    log:
        "logs/table1.log"
    params:
        level = config["level"]
    shell:
        "Rscript {input.script} --out {output} --level {params.level} "
        "{input.rds} > {log} 2>&1"

## The manuscript depends on the figure and the table, which depend on the
## simulations, which depend on the code.  That chain is the whole point: change
## sim.R and `snakemake` rebuilds the PDF, through every step in between.
rule manuscript:
    input:
        tex = "{doc}.tex",
        shared = ["main.tex", "preamble.tex"],
        figure = "results/figure1.pdf",
        table = "results/table1.tex"
    output:
        "build/{doc}.pdf"
    log:
        "logs/{doc}-latexmk.log"
    wildcard_constraints:
        doc = "paper|submission"
    shell:
        "latexmk -pdf -interaction=nonstopmode -outdir=build {input.tex} "
        "> {log} 2>&1"
