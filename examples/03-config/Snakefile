configfile: "config.yaml"

## The iteration count names the directory the results go in, so a 20-iteration
## smoke run and a 1000-iteration final run sit side by side instead of
## overwriting each other.  ITER picks which of them the figure is built from.
ITER  = config["iterations"]
SEED  = config["seed"]
LEVEL = config["level"]

## Wildcards match greedily by default; these constraints keep {n} from
## swallowing part of the filename when a rule could match more than one way
wildcard_constraints:
    iterations = r"\d+",
    n = r"\d+",
    rho = r"\d+",
    method = "[a-z]+"

rule all:
    input:
        "out/figure1.pdf"

rule sim:
    input:
        script = "code/sim.R",
        setup = "code/setup.R"
    output:
        "rds/{iterations}/sim/n{n}_rho{rho}_{method}.rds"
    shell:
        "Rscript {input.script} "
        "--n {wildcards.n} "
        "--rho {wildcards.rho} "
        "--method {wildcards.method} "
        "--iterations {wildcards.iterations} "
        "--seed {SEED} "
        "--level {LEVEL} "
        "--out {output}"

rule figure:
    input:
        script = "code/figure.R",
        setup = "code/setup.R",
        rds = expand("rds/{iterations}/sim/n{n}_rho{rho}_{method}.rds",
                     iterations=ITER, n=config["n"], rho=config["rho"],
                     method=config["methods"])
    output:
        "out/figure1.pdf"
    shell:
        "Rscript {input.script} --out {output} --level {LEVEL} {input.rds}"
