rule all:
    input:
        "out/figure1.pdf"

rule sim:
    input:
        "sim.R"
    output:
        "rds/sim/n{n}_rho{rho}_{method}.rds"
    shell:
        "Rscript sim.R "
        "--n {wildcards.n} "
        "--rho {wildcards.rho} "
        "--method {wildcards.method} "
        "--out {output}"

rule figure:
    input:
        script = "figure.R",
        rds = expand("rds/sim/n{n}_rho{rho}_{method}.rds",
                     n = [50, 100, 400],
                     rho = [0, 50, 80],
                     method = ["naive", "split"])
    output:
        "out/figure1.pdf"
    shell:
        "Rscript {input.script} {output} {input.rds}"
